PORT=8000
POSTGRES_PORT=5433

POSTGRES_DB=docpilot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

